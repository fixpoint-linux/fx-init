# cosmocc cross-build intermediates (staged in /tmp by the build, not the repo)
*.ape
*.ape.com.dbg
*.aarch64.elf
*.com.dbg
*.o

# elm / node / mfe (docs-site surface)
dist/
elm-stuff/
node_modules/
vendor/@mfe/

# build scratch
build-tmp/
build-wasm/
*.build.*

# local runtime artifacts (never commit)
/fx/

# built binaries (host-verify / dhake outputs)
/fx-init
/fx-activate
/fxctl
/fakesvc
*.b.out

# zig port build artifacts
/zig/.zig-cache/
/zig/zig-out/
/zig/.zig-cache
/zig/zig-out
