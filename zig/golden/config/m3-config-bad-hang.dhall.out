hostname=fixbox
package[0]=dhake
package[1]=fx-init
package[2]=fxctl
package[3]=fx-activate
package[4]=fake-service
user[0].name=root
user[0].uid=0
service[0].name=gate
service[0].argv[0]=fakesvc
service[0].argv[1]=hang
service[0].pkg=fake-service
service[0].on_kind=FX_ON_ALL
service[0].on_arg=-
service[0].restart=FX_RESTART_ALWAYS
