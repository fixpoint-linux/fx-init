hostname=fixbox
package[0]=dhake
package[1]=fx-init
package[2]=fxctl
package[3]=fake-service
user[0].name=root
user[0].uid=0
user[1].name=alice
user[1].uid=1000
user[1].groups[0]=wheel
user[1].groups[1]=audio
service[0].name=heartbeat
service[0].argv[0]=fakesvc
service[0].argv[1]=ok
service[0].pkg=fake-service
service[0].on_kind=FX_ON_ALL
service[0].on_arg=-
service[0].restart=FX_RESTART_ALWAYS
service[0].backoff_ms=500
service[0].probe_kind=FX_PROBE_FILE
service[0].probe_arg=/run/fx/ready-heartbeat
service[0].env[0].key=BEAT
service[0].env[0].value=hz2
service[1].name=after-heartbeat
service[1].argv[0]=fakesvc
service[1].argv[1]=ok
service[1].pkg=fake-service
service[1].on_kind=FX_ON_UP
service[1].on_arg=heartbeat
service[1].restart=FX_RESTART_ALWAYS
service[1].backoff_ms=1000
service[1].probe_kind=FX_PROBE_NONE
service[1].probe_arg=-
etc[0].path=motd
etc[0].content=welcome to fixbox
grace_ms=5000
