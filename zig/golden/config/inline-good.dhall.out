hostname=fixbox
package[0]=dhake
user[0].name=root
user[0].uid=0
service[0].name=sh
service[0].argv[0]=/usr/fx-core/bin/fxsh
service[0].pkg=-
service[0].on_kind=FX_ON_ALL
service[0].on_arg=-
service[0].restart=FX_RESTART_NEVER
service[0].backoff_ms=1000
service[0].probe_kind=FX_PROBE_NONE
service[0].probe_arg=-
service[0].console=console
grace_ms=3000
agent_service=sh
ipkg[0].name=agentsvc
ipkg[0].version=1.0
ipkg[0].src=path:/fx/disk/agent-src/agentsvc
ipkg[0].excludes[0]=scratch
ipkg[0].target=agentsvc
ipkg[0].recipe[0].kind=Mkdir
ipkg[0].recipe[0].a=out
ipkg[0].recipe[0].b=-
ipkg[0].recipe[1].kind=Copy
ipkg[0].recipe[1].a=Mcp.elm
ipkg[0].recipe[1].b=out/mcp.lua
ipkg[0].recipe[2].kind=Chmod
ipkg[0].recipe[2].a=out/mcp.lua
ipkg[0].recipe[2].b=0755
ipkg[0].recipe[3].kind=Echo
ipkg[0].recipe[3].a=built
ipkg[0].recipe[3].b=-
ipkg[0].recipe[4].kind=Env
ipkg[0].recipe[4].a=FX
ipkg[0].recipe[4].b=1
ipkg[0].recipe[5].kind=Touch
ipkg[0].recipe[5].a=out/stamp
ipkg[0].recipe[5].b=-
ipkg[0].recipe[6].kind=Run
ipkg[0].recipe[6].a=/usr/fx-agent/bin/luajit
ipkg[0].recipe[6].b=-
ipkg[0].recipe[6].argv[0]=/usr/fx-agent/bin/luajit
ipkg[0].recipe[6].argv[1]=-b
ipkg[0].recipe[6].argv[2]=Mcp.elm
ipkg[0].recipe[6].argv[3]=out/mcp.lua
ipkg[0].recipe[7].kind=Symlink
ipkg[0].recipe[7].a=out/mcp.lua
ipkg[0].recipe[7].b=mcp
ipkg[0].recipe[8].kind=Move
ipkg[0].recipe[8].a=out/mcp.lua
ipkg[0].recipe[8].b=out/mcp2.lua
ipkg[0].recipe[9].kind=Rm
ipkg[0].recipe[9].a=out/stamp
ipkg[0].recipe[9].b=-
ipkg[1].name=agentsvc2
ipkg[1].version=0.1
ipkg[1].src=path:src/agentsvc2
ipkg[1].target=agentsvc2
