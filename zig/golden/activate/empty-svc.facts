boot_grace 30000
current 3
generation H H-system-generation/Dhakefile.dhall H-dhake/dhake.com E
install /bin/dhake H-dhake 0 H
install /bin/fx-activate H-fx-activate 0 H
install /bin/fxctl H-fxctl 0 H
install /bin/init H-fx-init 0 H
install /etc/group H-system-generation/etc/group 420 H
install /etc/hostname H-system-generation/etc/hostname 420 H
install /etc/passwd H-system-generation/etc/passwd 420 H
provides dhake H-dhake
provides fx-activate H-fx-activate
provides fx-init H-fx-init
provides fxctl H-fxctl
tool_fxstore /bin/fx-activate
user root 0 root
version 1
version 2
version 3
