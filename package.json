    },
    "keywords": [],
    "type": "module",
    "bugs": {
        "url": "https://github.com/fixpoint-linux/fx-init/issues"
    },
    "homepage": "https://github.com/fixpoint-linux/fx-init#readme",
    "devDependencies": {
        "elm": "^0.19.2-0",
        "elm-format": "^0.8.8",
        "happy-dom": "^20.11.6"
    },
    "allowScripts": {
        "elm@0.19.2-0": true,
        "elm-format@0.8.8": true
    }
